// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String            @id @default(cuid())
  name             String
  ruc              String            @unique
  logo             String?
  address          String
  currency         String            @default("USD")
  timezone         String            @default("America/Panama")
  country          String            @default("Panama")
  taxRate          Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  countryTaxId     String?
  taxName          String?           @default("ITBMS")
  
  // Relaciones
  categories       Category[]
  clients          Client[]
  countryTax       CountryTax?       @relation(fields: [countryTaxId], references: [id])
  currencies       Currency[]
  products         Product[]
  purchases        Purchase[]
  reportSettings   ReportSetting[]
  sales            Sale[]
  settings         Setting?
  suppliers        Supplier[]
  users            User[]
  warehouses       Warehouse[]
  
  // ✅ Campo de seguridad con nombre en minúscula para evitar conflicto
  securitySettings SecuritySettings?
}

model Warehouse {
  id              String              @id @default(cuid())
  name            String
  type            String
  address         String?
  phone           String?
  email           String?
  isActive        Boolean             @default(true)
  companyId       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  inventory       InventoryItem[]
  sourceMovements InventoryMovement[] @relation("SourceWarehouse")
  targetMovements InventoryMovement[] @relation("TargetWarehouse")
  locations       Location[]
  purchaseOrders  Purchase[]
  sales           Sale[]
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Location {
  id          String          @id @default(cuid())
  aisle       String
  shelf       String
  level       String
  position    String
  barcode     String?         @unique
  warehouseId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inventory   InventoryItem[]
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  password            String
  name                String
  lastName            String
  phone               String?
  role                String
  companyId           String
  isActive            Boolean             @default(true)
  lastLogin           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  failedLoginAttempts Int                 @default(0)
  lastPasswordChange  DateTime?           @default(now())
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean             @default(false)
  twoFactorSecret     String?
  passwordHistory     Json?
  audits              Audit[]
  inventoryMovements  InventoryMovement[]
  loginAttempts       LoginAttempt[]
  permissions         Permission[]
  purchases           Purchase[]
  sales               Sale[]
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions            UserSession[]
}

model Permission {
  id          String   @id @default(cuid())
  userId      String
  module      String
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canApprove  Boolean  @default(false)
  canExport   Boolean  @default(false)
  canPrint    Boolean  @default(false)
  canViewCost Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Audit {
  id        String   @id @default(cuid())
  userId    String
  action    String
  module    String
  recordId  String
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id              String           @id @default(cuid())
  internalCode    String           @unique
  sku             String           @unique
  barcode         String?          @unique
  qrCode          String?          @unique
  name            String
  description     String?
  brand           String?
  model           String?
  color           String?
  size            String?
  weight          Float?
  dimensions      Json?
  images          String[]         @default([])
  isActive        Boolean          @default(true)
  hasIva          Boolean          @default(true)
  unitOfMeasure   String           @default("Unidad")
  categoryId      String?
  subcategoryId   String?
  companyId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventory       InventoryItem[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcategory     Subcategory?     @relation(fields: [subcategoryId], references: [id])
  purchaseDetails PurchaseDetail[]
  saleDetails     SaleDetail[]
  variants        Variant[]
}

model Variant {
  id              String           @id @default(cuid())
  productId       String
  name            String
  value           String
  price           Float
  cost            Float
  sku             String?          @unique
  barcode         String?          @unique
  stock           Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventoryItems  InventoryItem[]
  purchaseDetails PurchaseDetail[]
  saleDetails     SaleDetail[]
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id            String        @id @default(cuid())
  name          String
  description   String?
  companyId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products      Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id          String    @id @default(cuid())
  name        String
  description String?
  categoryId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id             String              @id @default(cuid())
  productId      String
  variantId      String?
  warehouseId    String
  locationId     String?
  currentStock   Float               @default(0)
  availableStock Float               @default(0)
  reservedStock  Float               @default(0)
  transitStock   Float               @default(0)
  minStock       Float               @default(0)
  maxStock       Float               @default(0)
  reorderPoint   Float               @default(0)
  costMethod     String              @default("FIFO")
  standardCost   Float?
  lastCost       Float?
  averageCost    Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  location       Location?           @relation(fields: [locationId], references: [id])
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        Variant?            @relation(fields: [variantId], references: [id])
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  kardex         Kardex[]
}

model InventoryMovement {
  id                String        @id @default(cuid())
  type              String
  quantity          Float
  unitCost          Float
  totalCost         Float
  reference         String?
  description       String?
  inventoryItemId   String
  sourceWarehouseId String?
  targetWarehouseId String?
  userId            String
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  sourceWarehouse   Warehouse?    @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse?    @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  kardex            Kardex[]
}

model Kardex {
  id              String            @id @default(cuid())
  date            DateTime          @default(now())
  movementId      String
  inventoryItemId String
  quantityIn      Float             @default(0)
  quantityOut     Float             @default(0)
  balance         Float             @default(0)
  unitCost        Float             @default(0)
  totalCost       Float             @default(0)
  balanceCost     Float             @default(0)
  createdAt       DateTime          @default(now())
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  movement        InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  email         String?
  phone         String?
  ruc           String?    @unique
  address       String?
  contactPerson String?
  creditLimit   Float?
  paymentTerms  String?
  isActive      Boolean    @default(true)
  companyId     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  contacts      Contact[]
  documents     Document[]
  purchases     Purchase[]
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Client {
  id            String     @id @default(cuid())
  name          String
  email         String?
  phone         String?
  ruc           String?    @unique
  address       String?
  contactPerson String?
  creditLimit   Float?
  paymentTerms  String?
  isActive      Boolean    @default(true)
  companyId     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  documents     Document[]
  sales         Sale[]
}

model Contact {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  position   String?
  isPrimary  Boolean   @default(false)
  clientId   String?
  supplierId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Purchase {
  id           String           @id @default(cuid())
  number       String           @unique
  status       String           @default("PENDING")
  supplierId   String
  userId       String
  companyId    String
  warehouseId  String?
  purchaseDate DateTime         @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  subtotal     Float            @default(0)
  tax          Float            @default(0)
  total        Float            @default(0)
  currency     String           @default("USD")
  exchangeRate Float            @default(1)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  documents    Document[]
  payments     Payment[]
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  warehouse    Warehouse?       @relation(fields: [warehouseId], references: [id])
  details      PurchaseDetail[]
}

model PurchaseDetail {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  variantId  String?
  quantity   Float    @default(0)
  unitCost   Float    @default(0)
  totalCost  Float    @default(0)
  received   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant    Variant? @relation(fields: [variantId], references: [id])
}

model Sale {
  id           String       @id @default(cuid())
  number       String       @unique
  status       String       @default("PENDING")
  clientId     String
  userId       String
  companyId    String
  warehouseId  String?
  saleDate     DateTime     @default(now())
  deliveryDate DateTime?
  subtotal     Float        @default(0)
  discount     Float        @default(0)
  tax          Float        @default(0)
  total        Float        @default(0)
  currency     String       @default("USD")
  exchangeRate Float        @default(1)
  commission   Float?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  taxAmount    Float?
  taxName      String?
  taxRate      Float?
  documents    Document[]
  payments     Payment[]
  client       Client       @relation(fields: [clientId], references: [id])
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  details      SaleDetail[]
}

model SaleDetail {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  variantId String?
  quantity  Float    @default(0)
  unitPrice Float    @default(0)
  discount  Float    @default(0)
  total     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant   Variant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id          String    @id @default(cuid())
  type        String
  amount      Float     @default(0)
  reference   String?
  purchaseId  String?
  saleId      String?
  paymentDate DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  purchase    Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Document {
  id         String    @id @default(cuid())
  type       String
  name       String
  url        String
  clientId   String?
  supplierId String?
  purchaseId String?
  saleId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Setting {
  id                     String   @id @default(cuid())
  companyId              String   @unique
  allowNegativeInventory Boolean  @default(false)
  defaultCostMethod      String   @default("FIFO")
  taxIncluded            Boolean  @default(false)
  currency               String   @default("USD")
  timezone               String   @default("UTC")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Currency {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  symbol        String
  decimalPlaces Int      @default(2)
  exchangeRate  Float    @default(1)
  isBase        Boolean  @default(false)
  isActive      Boolean  @default(true)
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([code, companyId])
}

model CountryTax {
  id          String    @id @default(cuid())
  country     String    @unique
  taxName     String
  taxRate     Float
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  companies   Company[]
}

model ReportSetting {
  id        String   @id @default(cuid())
  companyId String
  reportId  String
  enabled   Boolean  @default(true)
  config    Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, reportId])
}

model SecuritySettings {
  id                    String   @id
  companyId             String   @unique
  twoFactorAuth         Boolean  @default(false)
  loginNotifications    Boolean  @default(true)
  sessionConcurrency    Boolean  @default(true)
  requireStrongPassword Boolean  @default(true)
  passwordExpiryDays    Int      @default(90)
  preventPasswordReuse  Boolean  @default(true)
  forceLogoutAfterDays  Int      @default(30)
  blockSuspiciousIPs    Boolean  @default(false)
  sessionTimeout        Int      @default(30)
  maxLoginAttempts      Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("SecuritySettings")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  device       String
  browser      String
  ipAddress    String?
  location     String?
  userAgent    String?
  lastActive   DateTime @default(now())
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  ipAddress String
  location  String?
  userAgent String?
  status    String
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([timestamp])
}