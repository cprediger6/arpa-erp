"use client"; // 💡 Vital: Debe ser un Client Component para usar hooks y estados

import { useState } from "react";
import { signIn } from "next-auth/react"; // 💡 Importación oficial
import { useRouter } from "next/navigation";

export default function LoginPage() {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const router = useRouter();

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setLoading(false);

    try {
      // 💡 NextAuth inyectará y validará automáticamente los tokens CSRF aquí
      const result = await signIn("credentials", {
        email,
        password,
        redirect: false, // 💡 Evita recargas bruscas de página
      });

      if (result?.error) {
        // Manejo de errores específicos (Credenciales incorrectas, usuario bloqueado, etc.)
        setError("Credenciales inválidas o cuenta inactiva.");
      } else {
        // Login exitoso, redirigimos al ERP
        router.push("/dashboard");
        router.refresh();
      }
    } catch (err) {
      console.error("Error durante el login:", err);
      setError("Ocurrió un error inesperado.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="flex min-h-screen items-center justify-center">
      <form onSubmit={handleLogin} className="w-full max-w-md p-8 space-y-4 border rounded shadow">
        <h2 className="text-2xl font-bold text-center">Ingreso al ERP</h2>
        
        {error && <p className="text-red-500 text-sm">{error}</p>}

        <div>
          <label className="block text-sm font-medium">Email</label>
          <input
            type="email"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            className="w-full p-2 border rounded"
            required
          />
        </div>

        <div>
          <label className="block text-sm font-medium">Contraseña</label>
          <input
            type="password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            className="w-full p-2 border rounded"
            required
          />
        </div>

        <button
          type="submit"
          disabled={loading}
          className="w-full p-2 bg-blue-600 text-white rounded hover:bg-blue-700 disabled:bg-gray-400"
        >
          {loading ? "Cargando..." : "Iniciar Sesión"}
        </button>
      </form>
    </div>
  );
}